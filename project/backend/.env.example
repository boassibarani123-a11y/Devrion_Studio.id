# Copy to backend/.env and fill in real values. NEVER commit the real .env.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="resto_pos"

# JWT signing secret: generate with `python -c "import secrets;print(secrets.token_hex(32))"`
JWT_SECRET="<generate-a-64-hex-secret>"
JWT_EXPIRE_HOURS="12"

# Object storage (menu photos, logo, QRIS, payment proof)
DEVRION_STORAGE_KEY="<storage-api-key>"
STORAGE_FALLBACK_URL="<storage-proxy-base-url>"
STORAGE_APP_NAME="devrion-resto"

# First founder account (created once at startup if it doesn't exist)
FOUNDER_EMAIL="founder@yourdomain.com"
FOUNDER_PASSWORD="<strong-password>"

# "true" seeds demo resto "Kopi Senja" + demo staff. Set "false" in production.
SEED_DEMO="false"
